{
  "typescript": {
    "deno": true
  },
  "json": {
    "deno": true
  },
  "markdown": {
    "deno": true
  },
  "excludes": [
    "**/node_modules",
    "**/__snapshots__",
    "**/_vendor",
    "**/dist",
    "bun.lock"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm"
  ]
}
