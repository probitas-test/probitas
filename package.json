{
  "name": "@probitas-test/probitas",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probitas-test/probitas.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/mod.ts",
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./client": {
      "bun": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./client/connectrpc": {
      "bun": "./src/client/connectrpc.ts",
      "types": "./dist/client/connectrpc.d.ts",
      "default": "./dist/client/connectrpc.js"
    },
    "./client/graphql": {
      "bun": "./src/client/graphql.ts",
      "types": "./dist/client/graphql.d.ts",
      "default": "./dist/client/graphql.js"
    },
    "./client/grpc": {
      "bun": "./src/client/grpc.ts",
      "types": "./dist/client/grpc.d.ts",
      "default": "./dist/client/grpc.js"
    },
    "./client/http": {
      "bun": "./src/client/http.ts",
      "types": "./dist/client/http.d.ts",
      "default": "./dist/client/http.js"
    },
    "./client/http/oidc": {
      "bun": "./src/client/http/oidc.ts",
      "types": "./dist/client/http/oidc.d.ts",
      "default": "./dist/client/http/oidc.js"
    },
    "./client/mongodb": {
      "bun": "./src/client/mongodb.ts",
      "types": "./dist/client/mongodb.d.ts",
      "default": "./dist/client/mongodb.js"
    },
    "./client/rabbitmq": {
      "bun": "./src/client/rabbitmq.ts",
      "types": "./dist/client/rabbitmq.d.ts",
      "default": "./dist/client/rabbitmq.js"
    },
    "./client/redis": {
      "bun": "./src/client/redis.ts",
      "types": "./dist/client/redis.d.ts",
      "default": "./dist/client/redis.js"
    },
    "./client/sql": {
      "bun": "./src/client/sql.ts",
      "types": "./dist/client/sql.d.ts",
      "default": "./dist/client/sql.js"
    },
    "./client/sql/duckdb": {
      "bun": "./src/client/sql/duckdb.ts",
      "types": "./dist/client/sql/duckdb.d.ts",
      "default": "./dist/client/sql/duckdb.js"
    },
    "./client/sql/mysql": {
      "bun": "./src/client/sql/mysql.ts",
      "types": "./dist/client/sql/mysql.d.ts",
      "default": "./dist/client/sql/mysql.js"
    },
    "./client/sql/postgres": {
      "bun": "./src/client/sql/postgres.ts",
      "types": "./dist/client/sql/postgres.d.ts",
      "default": "./dist/client/sql/postgres.js"
    },
    "./client/sql/sqlite": {
      "bun": "./src/client/sql/sqlite.ts",
      "types": "./dist/client/sql/sqlite.d.ts",
      "default": "./dist/client/sql/sqlite.js"
    },
    "./client/sqs": {
      "bun": "./src/client/sqs.ts",
      "types": "./dist/client/sqs.d.ts",
      "default": "./dist/client/sqs.js"
    },
    "./expect": {
      "bun": "./src/expect.ts",
      "types": "./dist/expect.d.ts",
      "default": "./dist/expect.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/cli.ts",
    "!src/cli/**",
    "!**/*_test.ts",
    "src/_vendor/**/LICENSE",
    "src/_vendor/**/README.md"
  ],
  "scripts": {
    "probitas": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "compile": "bun scripts/compile.ts",
    "jsr:sync": "bun scripts/sync_jsr.ts",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "biome lint .",
    "check": "tsc -p .",
    "test": "bun test --timeout 60000 ./internal ./src",
    "verify": "dprint check && biome lint . && tsc -p . && bun test --timeout 60000 ./internal ./src"
  },
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "@probitas-test/builder": "link:@probitas-test/builder",
    "@probitas-test/client-connectrpc": "link:@probitas-test/client-connectrpc",
    "@probitas-test/client-graphql": "link:@probitas-test/client-graphql",
    "@probitas-test/client-grpc": "link:@probitas-test/client-grpc",
    "@probitas-test/client-http": "link:@probitas-test/client-http",
    "@probitas-test/client-mongodb": "link:@probitas-test/client-mongodb",
    "@probitas-test/client-rabbitmq": "link:@probitas-test/client-rabbitmq",
    "@probitas-test/client-redis": "link:@probitas-test/client-redis",
    "@probitas-test/client-sql": "link:@probitas-test/client-sql",
    "@probitas-test/client-sql-duckdb": "link:@probitas-test/client-sql-duckdb",
    "@probitas-test/client-sql-mysql": "link:@probitas-test/client-sql-mysql",
    "@probitas-test/client-sql-postgres": "link:@probitas-test/client-sql-postgres",
    "@probitas-test/client-sql-sqlite": "link:@probitas-test/client-sql-sqlite",
    "@probitas-test/client-sqs": "link:@probitas-test/client-sqs",
    "@probitas-test/expect": "link:@probitas-test/expect",
    "@probitas-test/runner": "link:@probitas-test/runner",
    "outdent": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@core/errorutil": "npm:@jsr/core__errorutil@^1.2.1",
    "@core/unknownutil": "npm:@jsr/core__unknownutil@^4.3.0",
    "@logtape/logtape": "^1.3.11",
    "@logtape/pretty": "^1.3.11",
    "@probitas-test/core": "link:@probitas-test/core",
    "@probitas-test/discover": "link:@probitas-test/discover",
    "@probitas-test/internal-testing": "file:./internal/testing",
    "@std/assert": "npm:@jsr/std__assert@^1.0.16",
    "@std/cbor": "npm:@jsr/std__cbor@^0.1.9",
    "@std/cli": "npm:@jsr/std__cli@^1.0.25",
    "@std/dotenv": "npm:@jsr/std__dotenv@^0.225.6",
    "@std/jsonc": "npm:@jsr/std__jsonc@^1.0.2",
    "@std/path": "npm:@jsr/std__path@^1.1.4",
    "@std/streams": "npm:@jsr/std__streams@^1.0.16",
    "@std/testing": "npm:@jsr/std__testing@^1.0.16",
    "@std/text": "npm:@jsr/std__text@^1.0.17",
    "@types/bun": "^1.4.2",
    "dprint": "0.61.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
