{
  "name": "@probitas-test/probitas",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./client": "./src/client.ts",
    "./client/connectrpc": "./src/client/connectrpc.ts",
    "./client/graphql": "./src/client/graphql.ts",
    "./client/grpc": "./src/client/grpc.ts",
    "./client/http": "./src/client/http.ts",
    "./client/http/oidc": "./src/client/http/oidc.ts",
    "./client/mongodb": "./src/client/mongodb.ts",
    "./client/rabbitmq": "./src/client/rabbitmq.ts",
    "./client/redis": "./src/client/redis.ts",
    "./client/sql": "./src/client/sql.ts",
    "./client/sql/duckdb": "./src/client/sql/duckdb.ts",
    "./client/sql/mysql": "./src/client/sql/mysql.ts",
    "./client/sql/postgres": "./src/client/sql/postgres.ts",
    "./client/sql/sqlite": "./src/client/sql/sqlite.ts",
    "./client/sqs": "./src/client/sqs.ts",
    "./expect": "./src/expect.ts"
  },
  "scripts": {
    "probitas": "bun src/cli.ts",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "biome lint .",
    "check": "tsc -p .",
    "test": "bun test --timeout 60000 ./internal ./src",
    "verify": "dprint check && biome lint . && tsc -p . && bun test --timeout 60000 ./internal ./src"
  },
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "@probitas-test/builder": "link:@probitas-test/builder",
    "@probitas-test/client-connectrpc": "link:@probitas-test/client-connectrpc",
    "@probitas-test/client-graphql": "link:@probitas-test/client-graphql",
    "@probitas-test/client-grpc": "link:@probitas-test/client-grpc",
    "@probitas-test/client-http": "link:@probitas-test/client-http",
    "@probitas-test/client-mongodb": "link:@probitas-test/client-mongodb",
    "@probitas-test/client-rabbitmq": "link:@probitas-test/client-rabbitmq",
    "@probitas-test/client-redis": "link:@probitas-test/client-redis",
    "@probitas-test/client-sql": "link:@probitas-test/client-sql",
    "@probitas-test/client-sql-duckdb": "link:@probitas-test/client-sql-duckdb",
    "@probitas-test/client-sql-mysql": "link:@probitas-test/client-sql-mysql",
    "@probitas-test/client-sql-postgres": "link:@probitas-test/client-sql-postgres",
    "@probitas-test/client-sql-sqlite": "link:@probitas-test/client-sql-sqlite",
    "@probitas-test/client-sqs": "link:@probitas-test/client-sqs",
    "@probitas-test/expect": "link:@probitas-test/expect",
    "@probitas-test/runner": "link:@probitas-test/runner",
    "outdent": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@core/errorutil": "npm:@jsr/core__errorutil@^1.2.1",
    "@core/unknownutil": "npm:@jsr/core__unknownutil@^4.3.0",
    "@logtape/logtape": "^1.3.11",
    "@logtape/pretty": "^1.3.11",
    "@probitas-test/core": "link:@probitas-test/core",
    "@probitas-test/discover": "link:@probitas-test/discover",
    "@probitas-test/internal-testing": "file:./internal/testing",
    "@std/assert": "npm:@jsr/std__assert@^1.0.16",
    "@std/cbor": "npm:@jsr/std__cbor@^0.1.9",
    "@std/cli": "npm:@jsr/std__cli@^1.0.25",
    "@std/dotenv": "npm:@jsr/std__dotenv@^0.225.6",
    "@std/jsonc": "npm:@jsr/std__jsonc@^1.0.2",
    "@std/path": "npm:@jsr/std__path@^1.1.4",
    "@std/streams": "npm:@jsr/std__streams@^1.0.16",
    "@std/testing": "npm:@jsr/std__testing@^1.0.16",
    "@std/text": "npm:@jsr/std__text@^1.0.17",
    "@types/bun": "^1.4.2",
    "dprint": "0.61.1",
    "typescript": "5.9.3"
  }
}
