{
  "name": "@probitas/probitas",
  "version": "1.0.0",
  "license": "MIT",
  "nodeModulesDir": "none",
  "exports": {
    ".": "./src/mod.ts",
    "./client": "./src/client.ts",
    "./client/connectrpc": "./src/client/connectrpc.ts",
    "./client/graphql": "./src/client/graphql.ts",
    "./client/grpc": "./src/client/grpc.ts",
    "./client/http": "./src/client/http.ts",
    "./client/http/oidc": "./src/client/http/oidc.ts",
    "./client/mongodb": "./src/client/mongodb.ts",
    "./client/rabbitmq": "./src/client/rabbitmq.ts",
    "./client/redis": "./src/client/redis.ts",
    "./client/sql": "./src/client/sql.ts",
    "./client/sql/duckdb": "./src/client/sql/duckdb.ts",
    "./client/sql/mysql": "./src/client/sql/mysql.ts",
    "./client/sql/postgres": "./src/client/sql/postgres.ts",
    "./client/sql/sqlite": "./src/client/sql/sqlite.ts",
    "./client/sqs": "./src/client/sqs.ts",
    "./expect": "./src/expect.ts"
  },
  "imports": {
    "@faker-js/faker": "npm:@faker-js/faker@^10.2.0",
    "@faker-js/faker/": "npm:@faker-js/faker@^10.2.0/",
    "@probitas-test/builder": "jsr:@probitas/builder@^0.5.3",
    "@probitas-test/client-connectrpc": "jsr:@probitas/client-connectrpc@^0.7.1",
    "@probitas-test/client-graphql": "jsr:@probitas/client-graphql@^0.7.0",
    "@probitas-test/client-grpc": "jsr:@probitas/client-grpc@^0.6.1",
    "@probitas-test/client-http": "jsr:@probitas/client-http@^0.8.0",
    "@probitas-test/client-http/oidc": "jsr:@probitas/client-http@^0.8.0/oidc",
    "@probitas-test/client-mongodb": "jsr:@probitas/client-mongodb@^0.6.1",
    "@probitas-test/client-rabbitmq": "jsr:@probitas/client-rabbitmq@^0.5.1",
    "@probitas-test/client-redis": "jsr:@probitas/client-redis@^0.5.1",
    "@probitas-test/client-sql": "jsr:@probitas/client-sql@^0.5.1",
    "@probitas-test/client-sql-duckdb": "jsr:@probitas/client-sql-duckdb@^0.5.1",
    "@probitas-test/client-sql-mysql": "jsr:@probitas/client-sql-mysql@^0.5.1",
    "@probitas-test/client-sql-postgres": "jsr:@probitas/client-sql-postgres@^0.5.1",
    "@probitas-test/client-sql-sqlite": "jsr:@probitas/client-sql-sqlite@^0.6.0",
    "@probitas-test/client-sqs": "jsr:@probitas/client-sqs@^0.6.0",
    "@probitas-test/expect": "jsr:@probitas/expect@^0.5.0",
    "@probitas-test/runner": "jsr:@probitas/runner@^0.5.7",
    "outdent": "npm:outdent@^0.8.0",
    "outdent/": "npm:outdent@^0.8.0/"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "deno.json",
      "src/**/*.ts",
      "src/_vendor/**/LICENSE"
    ],
    "exclude": [
      "src/cli.ts",
      "src/cli/**",
      "**/*_test.ts"
    ]
